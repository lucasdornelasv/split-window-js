{
  "name": "split-window-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/css-animation",
    "packages/keyframes-animation",
    "packages/angular",
    "e2e"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo-angular",
    "build": "npm run build:core && npm run build:engines && npm run build:angular && npm run build:demo",
    "build:core": "npm run build -w @split-window/core",
    "build:css-animation": "npm run build -w @split-window/css-animation",
    "build:keyframes-animation": "npm run build -w @split-window/keyframes-animation",
    "build:engines": "npm run build:css-animation && npm run build:keyframes-animation",
    "build:angular": "ng build angular",
    "build:demo": "ng build demo-angular",
    "test": "npm run test:core:coverage && npm run test:engines && npm run test:angular && npm run test:angular:zone",
    "test:core": "npm run test -w @split-window/core",
    "test:core:coverage": "npm run test:coverage -w @split-window/core",
    "test:engines": "npm run test -w @split-window/css-animation && npm run test -w @split-window/keyframes-animation",
    "test:angular": "ng test angular --watch=false",
    "test:angular:zone": "ng test angular --watch=false -c zone",
    "e2e": "npm run test -w @split-window/e2e",
    "e2e:install": "npm exec -w @split-window/e2e -- playwright install --with-deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @split-window/core && npm run typecheck -w @split-window/css-animation && npm run typecheck -w @split-window/keyframes-animation && tsc -p packages/angular/tsconfig.lib.json --noEmit && tsc -p apps/demo-angular/tsconfig.app.json --noEmit && tsc -p e2e/tsconfig.json",
    "docs:api": "typedoc",
    "version:set": "node scripts/set-version.mjs",
    "release": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.0",
    "ng-packagr": "^22.3.0",
    "prettier": "^3.8.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "zone.js": "^0.16.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasdornelasv/split-window-js.git"
  },
  "homepage": "https://github.com/lucasdornelasv/split-window-js#readme",
  "bugs": {
    "url": "https://github.com/lucasdornelasv/split-window-js/issues"
  }
}
