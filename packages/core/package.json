{
  "name": "@split-window/core",
  "version": "0.3.0",
  "description": "Framework-agnostic state and rules for tabbed split containers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasdornelasv/split-window-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lucasdornelasv/split-window-js/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/lucasdornelasv/split-window-js/issues"
  }
}
